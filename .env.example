# Copy to .env for local runs. On Vercel use Project → Settings → Environment
# Variables; on a VPS use your systemd/environment file. NEVER commit .env.

# ---------- Telegram ----------
# Get from @BotFather — rotate yours, the old token was exposed in chat.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_token
# Random 32+ char string; passed to setWebhook's secret_token and checked on
# every webhook call. Leave empty to disable the check (not recommended).
TELEGRAM_WEBHOOK_SECRET=

# ---------- MongoDB ----------
# The database name must match MONGO_DB (Atlas creates it on first write).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/ff_glory_bot?retryWrites=true&w=majority
MONGO_DB=ff_glory_bot

# ---------- Admin panel ----------
# Comma-separated Telegram user IDs. ONLY these IDs can see or use /admin and
# the admin buttons; everyone else gets an authorization error. Admins can
# change prices, API keys and wallets from the panel, but this list is
# environment-only so nobody can promote themselves.
ADMIN_IDS=123456789,987654321

# ---------- Pricing (initial values; editable from /admin) ----------
# final = base + base * margin/100 + fixed markup
PROFIT_MARGIN_PERCENT=25
FIXED_MARKUP_BDT=0
# Base API cost in BDT for one basic launch / one premium order:
BASIC_CREDIT_BDT=120
PREMIUM_CREDIT_BDT=350
USD_BDT_RATE=122

# ---------- Crypto deposit wallets (editable from /admin) ----------
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=
SUPPORT_CONTACT=@your_support

# ---------- Deposits (also editable from /admin -> Payment Settings) ----------
# The bKash number users send money to. The admin panel value overrides this;
# this is only the initial/fallback number.
BKASH_RECEIVER_NUMBER=01XXXXXXXXX
# Minimum accepted bKash/crypto deposit in BDT.
MIN_DEPOSIT_BDT=50

# ---------- bKash TrxID verification provider ----------
# Point these at whichever TrxID-check API you use. Field names and auth are
# configurable because providers differ.
BKASH_API_BASE_URL=https://api.your-provider.com
BKASH_API_KEY=
BKASH_VERIFY_PATH=/verify
# Optional second step (some providers verify then confirm/consume):
BKASH_CONFIRM_PATH=
BKASH_AUTH_HEADER=Authorization
BKASH_AUTH_SCHEME=Bearer
# json (JSON body) or form (x-www-form-urlencoded)
BKASH_PAYLOAD_MODE=json
# Request field names your provider expects:
BKASH_FIELD_TRX=trx_id
BKASH_FIELD_SENDER=mobile_number
BKASH_FIELD_AMOUNT=amount
# Verification behaviour
BKASH_TIMEOUT=12
BKASH_ATTEMPTS=3
BKASH_RETRY_DELAY=4
# Reject TrxIDs older than this (0 disables the check):
BKASH_MAX_AGE_HOURS=48

# ---------- Binance (read-only key: Enable Reading only, IP-restricted) ----------
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TIMEOUT=12
BINANCE_RECV_WINDOW=10000

# ---------- Credits ----------
# BDT per 1 unit of coin. Coins without a rate are credited manually.
# JSON or list form:
BDT_RATES=USDT=110.0

# ---------- FF Glory Reseller API (https://ffglory.pro) ----------
# Account API key (unique per account). Rotate it from the FFGlory panel if it
# was ever shared anywhere.
FFGLORY_API_KEY=
# Master key (same for everyone, from the FFGlory setup docs). Sent as the
# x-api-key header; the account key goes out as an api_key query parameter.
# Never hardcode this anywhere — set it here or in /admin → API Settings.
FFGLORY_MASTER_KEY=
# Optional — defaults to https://ffglory.pro
FFGLORY_BASE_URL=https://ffglory.pro

LOG_LEVEL=INFO
