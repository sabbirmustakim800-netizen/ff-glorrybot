# Copy to .env for local runs. On Vercel use Project → Settings → Environment
# Variables; on a VPS use your systemd/environment file. NEVER commit .env.

# ---------- Telegram ----------
# Get from @BotFather — rotate yours, the old token was exposed in chat.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_token
# Random 32+ char string; passed to setWebhook's secret_token and checked on
# every webhook call. Leave empty to disable the check (not recommended).
TELEGRAM_WEBHOOK_SECRET=

# ---------- MongoDB ----------
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/ff_glory_bot
MONGO_DB=ff_glory_bot

# ---------- bKash TrxID verification provider ----------
# Point these at whichever TrxID-check API you use. Field names and auth are
# configurable because providers differ.
BKASH_API_BASE_URL=https://api.your-provider.com
BKASH_API_KEY=
BKASH_VERIFY_PATH=/verify
# Optional second step (some providers verify then confirm/consume):
BKASH_CONFIRM_PATH=
BKASH_AUTH_HEADER=Authorization
BKASH_AUTH_SCHEME=Bearer
# json (JSON body) or form (x-www-form-urlencoded)
BKASH_PAYLOAD_MODE=json
# Request field names your provider expects:
BKASH_FIELD_TRX=trx_id
BKASH_FIELD_SENDER=mobile_number
BKASH_FIELD_AMOUNT=amount
# Verification behaviour
BKASH_TIMEOUT=12
BKASH_ATTEMPTS=3
BKASH_RETRY_DELAY=4
# Reject TrxIDs older than this (0 disables the check):
BKASH_MAX_AGE_HOURS=48

# ---------- Binance (read-only key: Enable Reading only, IP-restricted) ----------
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TIMEOUT=12
BINANCE_RECV_WINDOW=10000

# ---------- Credits ----------
# BDT per 1 unit of coin. Coins without a rate are credited manually.
# JSON or list form:
BDT_RATES=USDT=110.0

LOG_LEVEL=INFO